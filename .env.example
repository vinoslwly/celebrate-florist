# Celebrate Florist — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# See Phase 02B / Phase 05 (Notion) for the full engineering rationale behind
# this classification. Do not duplicate that documentation here.

# -----------------------------------------------------------------------------
# PUBLIC — bundled into the browser. Must never contain secrets.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SERVER-ONLY — never referenced in any "use client" file.
# -----------------------------------------------------------------------------
# Required starting Sprint where Studio privileged writes are implemented.
# Not required for Sprint 00 (connectivity check uses the anon key only).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# SECRETS — server-only, high sensitivity. Rotate immediately if leaked.
# -----------------------------------------------------------------------------
# Introduced when Memory Key hashing / access control is implemented.
MEMORY_KEY_PEPPER=
